APP_NAME=Reel Studio API
DATABASE_PATH=./data/reelstudio.db
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMP_DIR=./data/tmp
MAX_UPLOAD_MB=2048
DEMO_MODE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CACHE_DIR=./data/whisper-cache
ENABLE_GENERATED_AUDIO=true
ENABLE_VIDEO_RENDERING=true
