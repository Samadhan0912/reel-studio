APP_NAME=Reel Studio API
DATABASE_PATH=./data/reelstudio.db
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_UPLOAD_MB=2048
DEMO_MODE=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Connect adapters for transcription, LLM, TTS, and rendering before enabling real processing.
TRANSCRIPTION_PROVIDER=none
LLM_PROVIDER=none
TTS_PROVIDER=none
RENDER_PROVIDER=ffmpeg
